DATABASE_URL=sqlite:////app/data/radio.db
PUBLIC_BASE_URL=https://rizfm.pkasemer.com

# Shown on /privacy and /delete-data (required by the App Store and Google Play).
# Set PRIVACY_CONTACT_EMAIL to a monitored address before submitting the app.
APP_NAME=SOFIZ FM
PRIVACY_OPERATOR_NAME=SOFIZ FM
PRIVACY_CONTACT_EMAIL=
# Version shown on the landing page. Keep in step with "version" in the mobile app's app.json.
APP_VERSION=1.0.0

# Station loudness (see "Loudness" in API.md). Times are East Africa Time.
LOUDNESS_SLOTS=06:00,12:00,18:00,23:00
LOUDNESS_POLL_SECONDS=30

# Stream health (see "Stream Monitoring" in API.md). Intervals are in seconds, minimum 60.
HEALTH_HEALTHY_INTERVAL=300
HEALTH_SUSPECT_INTERVAL=60
HEALTH_OFFLINE_INTERVAL=900
# Optional: a chat webhook (Slack, Teams, Discord style) for "offline", "recovered" and daily reminder alerts.
HEALTH_ALERT_WEBHOOK_URL=
